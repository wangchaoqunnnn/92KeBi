# 92K 打板决策台 — systemd 守护(云服务器 Linux)
# 安装: sudo cp deploy/92kebi.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now 92kebi
# 常用: systemctl status 92kebi | journalctl -u 92kebi -f | systemctl restart 92kebi
[Unit]
Description=92K 打板决策台(实盘监测/打板入池/微信推送)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 项目绝对路径(按实际部署位置修改, 示例=/root/92KeBi)
WorkingDirectory=/root/92KeBi
ExecStart=/root/92KeBi/.venv/bin/python3 -X utf8 run.py
Restart=always
RestartSec=8
# 稳健性: 内存/文件句柄保护
LimitNOFILE=65536
# 日志(可被 journalctl 捕获; 如需落文件可改用 StandardOutput=append:/var/log/92kebi.log)
StandardOutput=journal
StandardError=journal
# 说明: 未用 OOMPolicy(需 systemd>=246, 老发行版会报 Unknown lvalue);
#       进程被 OOM 杀掉后由 Restart=always 自动拉起, 效果等价。

[Install]
WantedBy=multi-user.target
