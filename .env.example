# 数据源: real(默认, 新浪公开接口实时实盘) | mock(内置确定性模拟市场, 离线演示)
DATA_SOURCE=real

# ---- mock 参数(仅 DATA_SOURCE=mock 生效) ----
MOCK_SEED=920202406
MOCK_TRADING_DAYS=522

# ---- real 参数(新浪+腾讯 双数据源) ----
REAL_POLL_SECONDS=8        # 交易时段轮询间隔
REAL_FULL_EVERY=18         # 每N次tick执行一次全量同步(成分/行业/新增股), 平时走双源快速批量
REAL_PREF=                 # 强制快速源: tencent | sina_hq (留空=按延迟自动择优+故障切换)
REAL_CRAWL_N=500           # 分析/情绪历史/回测样本池=按当日成交额前N只
REAL_CRAWL_DAYS=520        # 样本池真实日K回填天数(约2年)
REAL_CRAWL_CONCURRENCY=8

# 服务监听
KB_HOST=127.0.0.1
KB_PORT=8720
# 数据库文件(默认 data/market.sqlite3=mock, data/market_real.sqlite3=real)
# KB_DB_PATH=

# ---- 企业微信群机器人(运行期也可写 data/wechat_webhook.txt, 一行一个 URL) ----
# WECHAT_WEBHOOK=
# 推送消息“点击直达”的页面地址:
# 默认已指向 https://wangchaoqun.top/92kebi/#/ops;
# 换域名/子路径时再设置覆盖, 例: WECHAT_PAGE_URL=https://你的域名/92kebi/#/ops
# WECHAT_PAGE_URL=
